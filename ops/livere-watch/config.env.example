# livere-watch 설정 — 복사해서 사용: cp config.env.example config.env
# 주의: config.env 는 .gitignore 처리됨(웹훅/토큰/앱비번 커밋 금지)

# ── AWS ──
export AWS_PROFILE=cizion-new
export AWS_REGION=ap-northeast-2

# 감시할 CloudWatch 알람 이름 접두어
export ALARM_PREFIX=Livere

# 백엔드 SSH 호스트 alias (~/.ssh/config 의 livere-prod)
export SSH_HOST=livere-prod

# ALB 타깃그룹 이름 필터(이것만 진단 수집)
export TG_FILTER=livere

# ── Slack (필수) ──
export SLACK_WEBHOOK_URL=""
# 알림 노이즈 억제 (lib.sh should_notify) — 미설정 시 코드 기본값(6 / 1800) 적용
export SLACK_MIN_SEV=6            # 이 심각도(1~10) 이상만 Slack. 미만(주의 이하)은 로그만.
export NOTIFY_COOLDOWN_SEC=1800   # 동일 알람 재알림 쿨다운(초). 심각도가 더 오르면 쿨다운 무시하고 즉시 알림.

# ── 자율도: observe(기본·자동 prod-write 없음) | safe(죽은 api 자동 재기동만) | aggressive ──
# ⚠ safe 로 바꾸면 무인 자동 재기동이 켜집니다. 검토 후 의식적으로 변경하세요.
export AUTONOMY=observe

# ── 경로/실행 바이너리(install.sh 가 절대경로 자동 주입) ──
export REPO_DIR="$HOME/cizion/codeofnature"
export CLAUDE_BIN="claude"
export AWS_BIN="aws"
export STATE_DIR="$HOME/.livere-watch"

# ── 위젯 캐너리 (1시간 주기, 댓글 정상출력 점검) ──
# 실제 운영 URL로 채우기. 비우면 해당 항목은 건너뜀.
export CANARY_WIDGET_JS_URL=""     # 위젯 main.js 공개 URL (예: CDN의 main.js)
export CANARY_API_HEALTH_URL=""    # API 헬스/핑 엔드포인트
export CANARY_COMMENTS_URL=""      # 특정 페이지 댓글 조회 API (200 + 본문>2B 면 정상)
export CANARY_MAX_MS=2000          # 이보다 느리면 심각도 가중 (기준 추후 검토)

# ── 이메일 알람 수신 (선택, dev@cizion.com CloudWatch 메일) ──
# EMAIL_APP_PASSWORD 미설정시 이메일 폴링 비활성(CloudWatch API 폴링이 1차).
export EMAIL_USER="dev@cizion.com"
export EMAIL_APP_PASSWORD=""        # Google 워크스페이스 '앱 비밀번호'
export IMAP_HOST="imap.gmail.com"
